{
  "name": "@kaguya/hello-xr-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:moonbit": "cd ../.. && moon build examples/hello-xr --target js --release",
    "prepare:moonbit": "pnpm build:moonbit && cp ../../_build/js/release/build/examples/hello-xr/hello-xr.js src/kaguya.generated.js",
    "predev": "pnpm prepare:moonbit",
    "dev": "vite --host",
    "build": "pnpm prepare:moonbit && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
