{
  "name": "@kaguya/hello-xr-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cd ../.. && moon build examples/hello-xr --target wasm --release",
    "prepare:wasm": "pnpm build:wasm && mkdir -p public && cp ../../_build/wasm/release/build/examples/hello-xr/hello-xr.wasm public/kaguya.wasm",
    "predev": "pnpm prepare:wasm",
    "dev": "vite --host",
    "build": "tsc --noEmit && pnpm prepare:wasm && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}
