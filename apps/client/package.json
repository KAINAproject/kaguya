{
  "name": "@kaguya/client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:moonbit": "moon build src --target js --release --target-dir .moonbit-build",
    "setup:types": "moon install mizchi/ts/cmd/mbt2ts@0.5.2 --bin .moonbit-tools",
    "ensure:types": "test -x .moonbit-tools/mbt2ts || pnpm run setup:types",
    "build:types": ".moonbit-tools/mbt2ts decl src/pkg.generated.mbti .moonbit-build/js/release/build/apps/client/src/src.d.ts",
    "predev": "pnpm run ensure:types && pnpm run build:moonbit && pnpm run build:types",
    "dev": "sh scripts/dev.sh",
    "prebuild": "pnpm run ensure:types && pnpm run build:moonbit && pnpm run build:types",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run typecheck && vite build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vite-plugin-wasm": "^3.4.1"
  },
  "dependencies": {
    "@kaguya/websocket-mbt": "link:../../packages/websocket-mbt/js",
    "@mizchi/three-mbt": "link:../../.mooncakes/mizchi/three/js",
    "three": "0.185.1"
  }
}
