// Kaguya browser application using the Three.js WebXR integration.

import {
  "KAINAproject/kaguya/packages/shared" @protocol,
  "KAINAproject/kaguya/packages/websocket-mbt" @websocket,
  "KAINAproject/kaguya/three/xr" @three_xr,
  "moonbitlang/async/js_async",
  "mizchi/js_browser/dom",
  "mizchi/js_core" @core,
  "mizchi/three",
}

pkgtype(kind: "foreign_library")

supported_targets = "js"
