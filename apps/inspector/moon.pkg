import {
  "KAINAproject/kaguya/packages/bridge-core" @bridge,
  "KAINAproject/kaguya/packages/inspector-tui" @inspector_ui,
  "KAINAproject/kaguya/packages/websocket-bridge" @wsbridge,
  "mizchi/tui",
  "mizchi/tui/io" @tui_io,
  "mizchi/tui/vnode",
  "moonbitlang/async",
  "moonbitlang/async/external_loop_integration" @external_loop,
